---
import { translator } from "../i18n.js";

interface Props {
  lang: string;
}

const t = translator(Astro.props.lang);
---

<section class="section" id="how" aria-labelledby="how-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">{t("how.eyebrow")}</p>
      <h2 id="how-title">{t("how.title")}</h2>
    </header>

    <figure class="diagram" data-3d-host>
      {/* Decorative 3D version of the diagram below; the SVG stays for screen readers. */}
      <div class="flow-3d" aria-hidden="true">
        <canvas></canvas>
        <div class="flow-labels"></div>
      </div>
      <svg viewBox="0 0 920 260" role="img" aria-labelledby="diagram-title">
        <title id="diagram-title">{t("diagram.title")}</title>
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 10 5 0 10z" fill="#FFBF43"/>
          </marker>
        </defs>
        {/* 1. Mixer with built-in USB audio: six channel strips (knobs + fader) and a master section */}
        <g class="d-device">
          <rect x="30" y="74" width="190" height="112" rx="10"/>
          <circle cx="50" cy="90" r="5"/><circle cx="72" cy="90" r="5"/><circle cx="94" cy="90" r="5"/>
          <circle cx="116" cy="90" r="5"/><circle cx="138" cy="90" r="5"/><circle cx="160" cy="90" r="5"/>
          <circle cx="50" cy="106" r="5"/><circle cx="72" cy="106" r="5"/><circle cx="94" cy="106" r="5"/>
          <circle cx="116" cy="106" r="5"/><circle cx="138" cy="106" r="5"/><circle cx="160" cy="106" r="5"/>
          <rect x="178" y="84" width="32" height="14" rx="3" class="d-led-dim"/>
          <rect x="183" y="118" width="8" height="56" rx="3" class="d-led"/>
          <rect x="197" y="132" width="8" height="42" rx="3" class="d-led"/>
        </g>
        <g class="d-slot">
          <rect x="48.5" y="120" width="3" height="54" rx="1.5"/><rect x="70.5" y="120" width="3" height="54" rx="1.5"/>
          <rect x="92.5" y="120" width="3" height="54" rx="1.5"/><rect x="114.5" y="120" width="3" height="54" rx="1.5"/>
          <rect x="136.5" y="120" width="3" height="54" rx="1.5"/><rect x="158.5" y="120" width="3" height="54" rx="1.5"/>
        </g>
        <g class="d-cap">
          <rect x="44" y="146" width="12" height="7" rx="2"/><rect x="66" y="134" width="12" height="7" rx="2"/>
          <rect x="88" y="152" width="12" height="7" rx="2"/><rect x="110" y="140" width="12" height="7" rx="2"/>
          <rect x="132" y="130" width="12" height="7" rx="2"/><rect x="154" y="148" width="12" height="7" rx="2"/>
        </g>
        <text x="125" y="216" class="d-label">{t("diagram.mixer")}</text>
        {/* USB cable */}
        <path d="M228 130 H318" class="d-link" marker-end="url(#arrow)"/>
        <text x="270" y="118" class="d-small">USB</text>
        {/* 2. Laptop */}
        <g class="d-device">
          <rect x="338" y="66" width="200" height="124" rx="10"/>
          <rect x="352" y="80" width="172" height="96" rx="4" class="d-screen"/>
          <path d="M318 200 H558 L546 212 H330 Z"/>
        </g>
        <g class="d-faders" aria-hidden="true">
          <rect x="372" y="118" width="6" height="46" rx="3"/><rect x="398" y="104" width="6" height="60" rx="3"/>
          <rect x="424" y="128" width="6" height="36" rx="3"/><rect x="450" y="96" width="6" height="68" rx="3"/>
          <rect x="476" y="112" width="6" height="52" rx="3"/><rect x="502" y="122" width="6" height="42" rx="3"/>
        </g>
        <text x="438" y="240" class="d-label">{t("diagram.desktop")}</text>
        {/* Wi-Fi */}
        <g class="d-wifi" fill="none">
          <path d="M600 112 a26 26 0 0 1 0 36"/>
          <path d="M614 98 a46 46 0 0 1 0 64"/>
          <path d="M628 84 a66 66 0 0 1 0 92"/>
        </g>
        <path d="M650 130 C 690 130 700 52 744 52" class="d-link d-dash" marker-end="url(#arrow)"/>
        <path d="M650 130 H744" class="d-link d-dash" marker-end="url(#arrow)"/>
        <path d="M650 130 C 690 130 700 208 744 208" class="d-link d-dash" marker-end="url(#arrow)"/>
        {/* 3. Phones */}
        <g class="d-device">
          <rect x="756" y="22" width="34" height="60" rx="7"/>
          <rect x="756" y="100" width="34" height="60" rx="7"/>
          <rect x="756" y="178" width="34" height="60" rx="7"/>
        </g>
        <text x="804" y="58" class="d-label d-left">{t("diagram.singer")}</text>
        <text x="804" y="136" class="d-label d-left">{t("diagram.drummer")}</text>
        <text x="804" y="214" class="d-label d-left">{t("diagram.keys")}</text>
        {/* step badges */}
        <g class="d-badge"><circle cx="40" cy="48" r="18"/><text x="40" y="54">1</text></g>
        <g class="d-badge"><circle cx="348" cy="46" r="18"/><text x="348" y="52">2</text></g>
        <g class="d-badge"><circle cx="612" cy="50" r="18"/><text x="612" y="56">3</text></g>
      </svg>
    </figure>

    <ol class="steps">
      <li class="card">
        <span class="step-num" aria-hidden="true">1</span>
        <h3>{t("step1.title")}</h3>
        <p set:html={t("step1.body")}></p>
      </li>
      <li class="card">
        <span class="step-num" aria-hidden="true">2</span>
        <h3>{t("step2.title")}</h3>
        <p>{t("step2.body")}</p>
      </li>
      <li class="card">
        <span class="step-num" aria-hidden="true">3</span>
        <h3>{t("step3.title")}</h3>
        <p>{t("step3.body")}</p>
      </li>
    </ol>
  </div>
</section>
