---
import { translator } from "../i18n.js";
import { REPOSITORY } from "../scripts/links.js";

interface Props {
  lang: string;
}

const t = translator(Astro.props.lang);
---

<section class="section" id="sponsor" aria-labelledby="sponsor-title">
  <div class="container">
    <div class="sponsor">
      <img src="/assets/brand/bandear-icon.svg" alt="" width="96" height="96">
      <div class="sponsor-copy">
        <h2 id="sponsor-title">{t("sponsor.title")}</h2>
        <p>{t("sponsor.body")}</p>
      </div>
      <div class="sponsor-actions">
        <a class="btn btn-primary" href="https://github.com/sponsors/brizons">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 4.3 2.4.7-1.2 2.2-2.4 4.3-2.4 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>
          <span>{t("sponsor.btn")}</span>
        </a>
        <a class="btn btn-ghost" href={REPOSITORY}>{t("sponsor.source")}</a>
      </div>
    </div>
  </div>
</section>
