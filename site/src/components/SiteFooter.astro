---
import { translator } from "../i18n.js";
import { REPOSITORY } from "../scripts/links.js";

interface Props {
  lang: string;
}

const t = translator(Astro.props.lang);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="brand" href="#top">
      <img src="/assets/brand/bandear-mark.svg" alt="" width="24" height="24">
      <span>BandEar</span>
    </a>
    <a class="maker" href="https://brizons.com">
      <span>{t("footer.by")}</span>
      <img src="/assets/brand/brizons-horizontal-negativo.svg" alt="Brizons" width="134" height="32" loading="lazy" decoding="async">
    </a>
    <p set:html={t("footer.license")}></p>
    <nav class="footer-links" aria-label={t("footer.label")}>
      <a href={REPOSITORY}>GitHub</a>
      <a href="https://github.com/brizons/bandear/releases">{t("footer.releases")}</a>
      <a href="https://github.com/brizons/bandear/issues">{t("footer.issues")}</a>
      <a href="https://github.com/sponsors/brizons">{t("footer.sponsor")}</a>
    </nav>
  </div>
</footer>
