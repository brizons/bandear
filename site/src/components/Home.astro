---
// The home page in one language; pages/index.astro (English, also x-default) and
// pages/es/index.astro render it.
import Page from "../layouts/Page.astro";
import Downloads from "./Downloads.astro";
import Faq from "./Faq.astro";
import Features from "./Features.astro";
import Hero from "./Hero.astro";
import HowItWorks from "./HowItWorks.astro";
import Screenshots from "./Screenshots.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import Sponsor from "./Sponsor.astro";
import { translator } from "../i18n.js";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = translator(lang);
---

<Page lang={lang}>
  <a class="skip-link" href="#main">{t("skip")}</a>
  <SiteHeader lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <HowItWorks lang={lang} />
    <Features lang={lang} />
    <Screenshots lang={lang} />
    <Downloads lang={lang} />
    <Faq lang={lang} />
    <Sponsor lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</Page>
